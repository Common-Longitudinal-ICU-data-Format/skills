# Python
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# Local non-PHI dev sandbox produced by scripts/setup_dev_data.sh (never commit data).
# Unanchored so they match at any depth: the script can be run from the repo root
# OR from skills/clif-icu/, so anchored /dev_data/ would miss skills/clif-icu/dev_data/.
dev_data/
synthetic_clif/
clif_demo_config.json

# clif-bench: pinned data stood up locally by bench/setup_bench_data.sh (never commit).
bench/.data/

# clifpy ClifOrchestrator's default output_directory ("./output" per
# bench/.data/config.json) — validation/error logs written as a side effect
# of instantiating ClifOrchestrator in bench task solutions (T05, T07); not
# task output, never commit.
output/
bench/output/
