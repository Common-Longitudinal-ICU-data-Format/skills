{
  "_comment": "This hook set is duplicated in .claude-plugin/marketplace.json (installed-plugin path). This file is the --plugin-dir dev path. Keep both in sync — see hooks/README.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/phi_guard.py\""}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/phi_scan.py\""}
        ]
      }
    ]
  }
}
